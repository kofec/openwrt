+	.is_prepared	= meson6_hdmi_pll_is_prepared,
+	.recalc_rate	= meson6_hdmi_pll_recalc_rate,
+	.determine_rate	= meson6_hdmi_pll_determine_rate,
+	.set_rate	= meson6_hdmi_pll_set_rate,
+};
