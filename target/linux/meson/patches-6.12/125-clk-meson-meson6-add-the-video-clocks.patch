+struct meson6_clk_reset {
+	struct reset_controller_dev reset;
+	struct regmap *regmap;
+};
+
+/* same lines as on Meson8b, see set_vid_pll_div() in the vendor kernel */
+static const struct meson6_clk_reset_line {
+	u32 reg;
+	u8 bit_idx;
+	bool active_low;
+} meson6_clk_reset_bits[] = {
+	[CLKC_RESET_VID_CLK_CNTL_SOFT_RESET] = {
+		.reg = HHI_VID_CLK_CNTL, .bit_idx = 15, .active_low = false,
+	},
+	[CLKC_RESET_VID_DIVIDER_CNTL_SOFT_RESET_POST] = {
+		.reg = HHI_VID_DIVIDER_CNTL, .bit_idx = 7, .active_low = false,
+	},
+	[CLKC_RESET_VID_DIVIDER_CNTL_SOFT_RESET_PRE] = {
+		.reg = HHI_VID_DIVIDER_CNTL, .bit_idx = 3, .active_low = false,
+	},
+	[CLKC_RESET_VID_DIVIDER_CNTL_RESET_N_POST] = {
+		.reg = HHI_VID_DIVIDER_CNTL, .bit_idx = 1, .active_low = true,
+	},
+	[CLKC_RESET_VID_DIVIDER_CNTL_RESET_N_PRE] = {
+		.reg = HHI_VID_DIVIDER_CNTL, .bit_idx = 0, .active_low = true,
+	},
+};
+
+static int meson6_clk_reset_update(struct reset_controller_dev *rcdev,
+				   unsigned long id, bool assert)
+{
+	struct meson6_clk_reset *rstc =
+		container_of(rcdev, struct meson6_clk_reset, reset);
+	const struct meson6_clk_reset_line *line;
+	unsigned int value = 0;
+	unsigned long flags;
+
+	if (id >= ARRAY_SIZE(meson6_clk_reset_bits))
+		return -EINVAL;
+
+	line = &meson6_clk_reset_bits[id];
+	if (!line->reg)
+		return -EINVAL;
+
+	if (assert != line->active_low)
+		value = BIT(line->bit_idx);
+
+	spin_lock_irqsave(&meson6_clk_reset_lock, flags);
+	regmap_update_bits(rstc->regmap, line->reg, BIT(line->bit_idx), value);
+	spin_unlock_irqrestore(&meson6_clk_reset_lock, flags);
+
+	return 0;
+}
+
+static int meson6_clk_reset_assert(struct reset_controller_dev *rcdev,
+				   unsigned long id)
+{
+	return meson6_clk_reset_update(rcdev, id, true);
+}
+
+static int meson6_clk_reset_deassert(struct reset_controller_dev *rcdev,
+				     unsigned long id)
+{
+	return meson6_clk_reset_update(rcdev, id, false);
+}
+
+static const struct reset_control_ops meson6_clk_reset_ops = {
+	.assert = meson6_clk_reset_assert,
+	.deassert = meson6_clk_reset_deassert,
+};
