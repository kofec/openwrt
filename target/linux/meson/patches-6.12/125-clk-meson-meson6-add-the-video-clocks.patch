From 15ebbab56b5344dbde4cc6df3b4e68c8e4cc2ad9 Mon Sep 17 00:00:00 2001
From: kofec <kofec@localhost>
Date: Fri, 13 Nov 2026 20:02:19 +0000
Subject: [PATCH] clk: meson: meson6: add the video clocks

Ported from meson8b.c (the register layout is the same), with the Meson6
differences:
- the video PLL (HPLL) is at HHI 0x270 instead of 0x320 and bit 30 of
  HHI_VID_PLL_CNTL is a power-down bit, so it gets its own ops: reset,
  analog settings (CNTL2..4 as on a running vendor system), M/N, wait
  for lock. VCO 1080, 1296 and 1485MHz like in the vendor kernel.
- the HDMI output divider uses 2 and 3 for divide-by-4.
- there is no HHI_VID_CLK_CNTL2, so cts_enc*/hdmi_tx_pixel are muxes.
- the HDMI/VENC gates in HHI_GCLK_MPEG2 are at different bits and
  HDMI_INTR_SYNC, VENCI_INT and VENCP_INT must stay enabled: with them
  gated the HDMI output has sync but black pixels.
- reset lines for the video dividers like on Meson8b.
---
 drivers/clk/meson/meson6.c | 1107 +++++++++++++++++++++++++++++++++++-
 1 file changed, 1105 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/meson/meson6.c b/drivers/clk/meson/meson6.c
index fbc477ca0..272fd37a7 100644
--- a/drivers/clk/meson/meson6.c
+++ b/drivers/clk/meson/meson6.c
@@ -19,16 +19,29 @@
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/regmap.h>
+#include <linux/reset-controller.h>
+#include <linux/slab.h>
 
 #include "clk-regmap.h"
 #include "clk-pll.h"
 #include "meson-clkc-utils.h"
 
 #include <dt-bindings/clock/meson8b-clkc.h>
+#include <dt-bindings/reset/amlogic,meson8b-clkc-reset.h>
 
 #define HHI_GCLK_MPEG0			0x140
 #define HHI_GCLK_MPEG1			0x144
 #define HHI_GCLK_MPEG2			0x148
+#define HHI_VIID_CLK_DIV		0x128
+#define HHI_VIID_CLK_CNTL		0x12c
+#define HHI_VID_CLK_DIV			0x164
+#define HHI_VID_CLK_CNTL		0x17c
+#define HHI_VID_DIVIDER_CNTL		0x198
+#define HHI_HDMI_CLK_CNTL		0x1cc
+#define HHI_VID_PLL_CNTL		0x270
+#define HHI_VID_PLL_CNTL2		0x274
+#define HHI_VID_PLL_CNTL3		0x278
+#define HHI_VID_PLL_CNTL4		0x27c
 #define HHI_MPEG_CLK_CNTL		0x174
 #define HHI_SYS_CPU_CLK_CNTL		0x19c
 #define HHI_SYS_PLL_CNTL		0x260
@@ -496,6 +509,978 @@ static struct clk_regmap meson6_clk_out3 = {
 	},
 };
 
+/* video clocks, from meson8b.c */
+
+/*
+ * The video PLL (also called HPLL) uses the same register layout as the HDMI
+ * PLL on Meson8b, only at a different offset and without fractional part:
+ * VCO = 24MHz * M / N. The vendor kernel uses 1080MHz (M = 45, N = 1),
+ * 1296MHz (CVBS) and 1485MHz (M = 495, N = 8) for all HDMI modes, the latter
+ * with HHI_VID_PLL_CNTL3/4 values from the vendor's "exact 1485MHz" code path.
+ * HHI_VID_PLL_CNTL2..4 are as found on a running 720p vendor system.
+ */
+static const struct reg_sequence meson6_hdmi_pll_init_regs[] = {
+	{ .reg = HHI_VID_PLL_CNTL2,	.def = 0x814d3928 },
+	{ .reg = HHI_VID_PLL_CNTL3,	.def = 0x4b525012 },
+	{ .reg = HHI_VID_PLL_CNTL4,	.def = 0x02000101 },
+};
+
+static const struct pll_params_table meson6_hdmi_pll_params_table[] = {
+	PLL_PARAMS(45, 1),
+	PLL_PARAMS(54, 1),
+	PLL_PARAMS(495, 8),
+	{ /* sentinel */ }
+};
+
+/*
+ * Unlike on Meson8b, bit 30 of HHI_VID_PLL_CNTL is a power-down bit on Meson6
+ * (vendor: "0x105c[30]PD, 1: PowerDown"), so the generic PLL ops (which set it
+ * to enable the PLL) can't be used. The PLL is programmed like in the vendor
+ * kernel: reset, analog settings, M/N, release reset, wait for the lock bit.
+ */
+static int meson6_hdmi_pll_program(struct clk_regmap *clk, unsigned int m,
+				   unsigned int n)
+{
+	struct meson_clk_pll_data *pll = clk->data;
+	int delay = 5000;
+
+	meson_parm_write(clk->map, &pll->rst, 1);
+	regmap_multi_reg_write(clk->map, pll->init_regs, pll->init_count);
+	regmap_update_bits(clk->map, HHI_VID_PLL_CNTL, BIT(30), 0);
+	meson_parm_write(clk->map, &pll->m, m);
+	meson_parm_write(clk->map, &pll->n, n);
+	meson_parm_write(clk->map, &pll->rst, 0);
+
+	/* the lock bit is only valid after 100us */
+	udelay(100);
+	do {
+		if (meson_parm_read(clk->map, &pll->l))
+			return 0;
+		udelay(20);
+	} while (--delay);
+
+	pr_err("%s: the video PLL did not lock (M = %u, N = %u)\n", __func__,
+	       m, n);
+
+	return -EIO;
+}
+
+static unsigned long meson6_hdmi_pll_recalc_rate(struct clk_hw *hw,
+						 unsigned long parent_rate)
+{
+	return meson_clk_pll_ro_ops.recalc_rate(hw, parent_rate);
+}
+
+static const struct pll_params_table *
+meson6_hdmi_pll_find(struct meson_clk_pll_data *pll, unsigned long rate,
+		     unsigned long parent_rate)
+{
+	const struct pll_params_table *best = NULL, *t;
+	unsigned long best_diff = ULONG_MAX;
+
+	for (t = pll->table; t->n; t++) {
+		unsigned long r = DIV_ROUND_CLOSEST_ULL((u64)parent_rate * t->m,
+							t->n);
+		unsigned long diff = abs_diff(r, rate);
+
+		if (diff < best_diff) {
+			best = t;
+			best_diff = diff;
+		}
+	}
+
+	return best;
+}
+
+static int meson6_hdmi_pll_determine_rate(struct clk_hw *hw,
+					  struct clk_rate_request *req)
+{
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	const struct pll_params_table *t;
+
+	if (!req->best_parent_rate)
+		return -EINVAL;
+
+	t = meson6_hdmi_pll_find(clk->data, req->rate, req->best_parent_rate);
+	if (!t)
+		return -EINVAL;
+
+	req->rate = DIV_ROUND_CLOSEST_ULL((u64)req->best_parent_rate * t->m,
+					  t->n);
+
+	return 0;
+}
+
+static int meson6_hdmi_pll_set_rate(struct clk_hw *hw, unsigned long rate,
+				    unsigned long parent_rate)
+{
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	const struct pll_params_table *t;
+
+	t = meson6_hdmi_pll_find(clk->data, rate, parent_rate);
+	if (!t)
+		return -EINVAL;
+
+	return meson6_hdmi_pll_program(clk, t->m, t->n);
+}
+
+/* U-Boot leaves the PLL powered down or unlocked */
+static int meson6_hdmi_pll_prepare(struct clk_hw *hw)
+{
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	struct meson_clk_pll_data *pll = clk->data;
+	unsigned int val;
+
+	regmap_read(clk->map, HHI_VID_PLL_CNTL, &val);
+	if (!(val & BIT(30)) && meson_parm_read(clk->map, &pll->l))
+		return 0;
+
+	return meson6_hdmi_pll_program(clk, meson_parm_read(clk->map, &pll->m),
+				       meson_parm_read(clk->map, &pll->n));
+}
+
+static int meson6_hdmi_pll_is_prepared(struct clk_hw *hw)
+{
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	struct meson_clk_pll_data *pll = clk->data;
+	unsigned int val;
+
+	regmap_read(clk->map, HHI_VID_PLL_CNTL, &val);
+
+	return !(val & BIT(30)) && meson_parm_read(clk->map, &pll->l);
+}
+
+static const struct clk_ops meson6_hdmi_pll_ops = {
