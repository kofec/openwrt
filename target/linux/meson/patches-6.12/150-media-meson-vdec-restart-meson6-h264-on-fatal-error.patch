From: kofec
Subject: [PATCH] media: meson: vdec: restart the Meson6 H.264 firmware on a fatal error

On 2026-11-20, watching live TV from an Enigma2 box in Kodi, the M6 H.264
firmware reported CMD_FATAL_ERROR and the session was aborted
(amvdec_abort()). Kodi could not reopen the decoder while it still held
pictures of the old context (only one session at a time), so no channel
played any more until Kodi was restarted.

The vendor driver restarts the firmware in place on a fatal error
(error_do_work(): amvdec_stop(), vh264_prot_init(), amvdec_start(); the
program stays in IMEM). Do the same on Meson6 from the codec watchdog
hook, run by the recycle thread, which also drops the pending recycle
list since the restarted firmware considers every buffer free. The
firmware parses the next SPS and sends CMD_SRC_CHANGE again, so resume()
now frees the previous reference MV buffer before allocating it. More
than 5 fatal errors within 10 s still abort the session.

The fatal-error interrupt masks the mailbox, the restart flag is an atomic
exchanged by the watchdog, and the watchdog waits for a running threaded
ISR (synchronize_irq()) before resetting the VLD (review by Gemini).

Restart limited to once per session and each step logged: on
2026-11-20 the box stopped answering right after the first restart
(kernel with the copy still in the RT interrupt thread); cause unknown.

--- a/drivers/staging/media/meson/vdec/codec_h264.c	2026-11-19 23:33:26.000000000 +0100
+++ b/drivers/staging/media/meson/vdec/codec_h264.c	2026-11-20 13:25:40.449505900 +0100
@@ -5,6 +5,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/interrupt.h>
 #include <media/v4l2-mem2mem.h>
 #include <media/videobuf2-dma-contig.h>
 
@@ -147,6 +148,10 @@
 	u32 max_refs;
 	/* Meson6: level_idc from AV_SCRATCH_A at the source change */
 	u32 level_idc;
+	/* Meson6: firmware fatal error, restart from the watchdog */
+	atomic_t restart;
+	unsigned int restarts;
+	unsigned long restart_window;
 };
 
 /*
@@ -386,6 +391,13 @@
 	mb_height = ALIGN(h264->mb_height, 4);
 	mb_total = mb_width * mb_height;
 
+	/* a firmware restarted after a fatal error asks for them again */
+	if (h264->ref_vaddr) {
+		dma_free_coherent(core->dev, h264->ref_size,
+				  h264->ref_vaddr, h264->ref_paddr);
+		h264->ref_vaddr = NULL;
+	}
+
 	h264->ref_size = mb_total * MB_MV_SIZE * h264->max_refs;
 	h264->ref_vaddr = dma_alloc_coherent(core->dev, h264->ref_size,
 					     &h264->ref_paddr, GFP_KERNEL);
@@ -525,6 +537,86 @@
 	}
 }
 
+/*
+ * Meson6: the firmware reports CMD_FATAL_ERROR on broken input (e.g. a DVB
+ * stream that starts in the middle of a GOP after a channel change) and
+ * then decodes nothing more. Aborting the session left Kodi with a decoder
+ * it could not reopen while it still held pictures of the old one, so no
+ * channel played until Kodi restarted. Like the vendor error_do_work()
+ * (amvdec_stop(), vh264_prot_init(), amvdec_start(), firmware kept in IMEM),
+ * restart the firmware in place; it parses the next SPS and asks for the
+ * parameters again (CMD_SRC_CHANGE). More than 5 fatal errors in 10 s still
+ * abort.
+ */
+static bool codec_h264_meson6_want_restart(struct amvdec_session *sess)
+{
+	struct codec_h264 *h264 = sess->priv;
+
+	if (!sess->core->platform->meson6 || !h264)
+		return false;
+
+	if (time_after(jiffies, h264->restart_window + 10 * HZ)) {
+		h264->restart_window = jiffies;
+		h264->restarts = 0;
+	}
+	/*
+	 * Once per session for now: on 20.11 the box stopped answering right
+	 * after "restarting it (1)" and the cause is not known yet.
+	 */
+	if (++h264->restarts > 1)
+		return false;
+
+	/* the stopped firmware must not interrupt again before the restart */
+	amvdec_write_dos(sess->core, ASSIST_MBOX1_MASK, 0);
+	atomic_set(&h264->restart, 1);
+	return true;
+}
+
+/* called from the recycle thread, with bufs_recycle_lock held */
+static bool codec_h264_watchdog(struct amvdec_session *sess)
+{
+	struct amvdec_core *core = sess->core;
+	struct codec_h264 *h264 = sess->priv;
+	u32 workspace_offset;
+
+	if (!h264 || sess->status == STATUS_STOPPED ||
+	    !atomic_xchg(&h264->restart, 0))
+		return false;
+
+	/* no threaded ISR may read AV_SCRATCH_* while the VLD is reset */
+	amvdec_write_dos(core, ASSIST_MBOX1_MASK, 0);
+	synchronize_irq(core->irq);
+	dev_warn_ratelimited(core->dev_dec,
+			     "H.264 firmware fatal error, restarting it (%u)\n",
+			     h264->restarts);
+
+	amvdec_meson6_cpu_stop(core);
+	dev_info(core->dev_dec, "H.264 restart: firmware stopped\n");
+
+	/* vh264_prot_init() */
+	codec_h264_meson6_reset(core);
+	dev_info(core->dev_dec, "H.264 restart: decoder blocks reset\n");
+	amvdec_write_dos_bits(core, POWER_CTL_VLD, BIT(9) | BIT(6));
+	workspace_offset = h264->workspace_paddr - WORKSPACE_BUF_OFFSET;
+	amvdec_write_dos(core, AV_SCRATCH_1, workspace_offset);
+	amvdec_write_dos(core, AV_SCRATCH_G, h264->ext_fw_paddr);
+	amvdec_write_dos(core, AV_SCRATCH_I, h264->sei_paddr - workspace_offset);
+	amvdec_write_dos(core, AV_SCRATCH_F,
+			 (amvdec_read_dos(core, AV_SCRATCH_F) & 0xffffff83) |
+			 BIT(4));
+	if (sess->pixfmt_cap == V4L2_PIX_FMT_NV12M)
+		amvdec_write_dos_bits(core, MDEC_PIC_DC_CTRL, BIT(17));
+
+	amvdec_write_dos(core, ASSIST_MBOX1_CLR_REG, 1);
+	amvdec_write_dos(core, ASSIST_MBOX1_MASK, 1);
+	amvdec_meson6_cpu_reset(core);
+	amvdec_write_dos(core, MPSR, 1);
+	dev_info(core->dev_dec, "H.264 restart: firmware started\n");
+
+	/* the restarted firmware considers every buffer free */
+	return true;
+}
+
 static irqreturn_t codec_h264_threaded_isr(struct amvdec_session *sess)
 {
 	struct amvdec_core *core = sess->core;
@@ -544,6 +636,8 @@
 		break;
 	case CMD_FATAL_ERROR:
 		dev_err(core->dev, "H.264 decoder fatal error\n");
+		if (codec_h264_meson6_want_restart(sess))
+			break;
 		goto abort;
 	case CMD_BAD_WIDTH:
 		size = (amvdec_read_dos(core, AV_SCRATCH_1) + 1) * 16;
@@ -616,5 +710,6 @@
 	.recycle = codec_h264_recycle,
 	.eos_sequence = codec_h264_eos_sequence,
 	.starved = codec_h264_starved,
+	.watchdog = codec_h264_watchdog,
 	.resume = codec_h264_resume,
 };
