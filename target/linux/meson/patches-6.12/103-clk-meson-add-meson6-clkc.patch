+	[CLKID_USB1]			= &meson6_usb1.hw,
+	[CLKID_USB]			= &meson6_usb.hw,
+	[CLKID_EFUSE]			= &meson6_efuse.hw,
+	[CLKID_USB1_DDR_BRIDGE]		= &meson6_usb1_ddr_bridge.hw,
+	[CLKID_USB0_DDR_BRIDGE]		= &meson6_usb0_ddr_bridge.hw,
+	[CLKID_UART2]			= &meson6_uart2.hw,
+	[CLKID_PERIPH]			= &meson6_periph_clk.hw,
+	[MESON6_CLKID_CLK_OUT3]		= &meson6_clk_out3.hw,
+};
+
+static struct clk_regmap *const meson6_clk_regmaps[] = {
+	&meson6_fixed_pll_dco,
+	&meson6_sys_pll_dco,
+	&meson6_sys_pll,
+	&meson6_mpeg_clk_sel,
+	&meson6_mpeg_clk_div,
+	&meson6_clk81,
+	&meson6_cpu_in_sel,
+	&meson6_cpu_scale_out_sel,
+	&meson6_cpu_clk,
+	&meson6_i2c,
+	&meson6_sar_adc,
+	&meson6_rng0,
+	&meson6_uart0,
+	&meson6_sdio,
+	&meson6_eth,
+	&meson6_uart1,
+	&meson6_usb0,
+	&meson6_usb1,
+	&meson6_usb,
+	&meson6_efuse,
+	&meson6_usb1_ddr_bridge,
+	&meson6_usb0_ddr_bridge,
+	&meson6_uart2,
+	&meson6_clk_out3,
+};
+
+static struct meson_clk_hw_data meson6_clk_hw_data = {
+	.hws = meson6_hw_clks,
+	.num = ARRAY_SIZE(meson6_hw_clks),
+};
+
+static void __init meson6_clkc_init(struct device_node *np)
+{
+	struct device_node *parent_np;
+	struct regmap *map;
+	int i, ret;
+
+	parent_np = of_get_parent(np);
+	map = syscon_node_to_regmap(parent_np);
+	of_node_put(parent_np);
+	if (IS_ERR(map)) {
+		pr_err("%s: failed to get the HHI regmap\n", __func__);
+		return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(meson6_clk_regmaps); i++)
+		meson6_clk_regmaps[i]->map = map;
+
+	/* source and divider of CLK_OUT3 as set up by the vendor kernel */
+	regmap_update_bits(map, HHI_GEN_CLK_CNTL2, BIT(22) | GENMASK(18, 13),
+			   BIT(22));
+
+	for (i = 0; i < ARRAY_SIZE(meson6_internal_hws); i++) {
+		ret = of_clk_hw_register(np, meson6_internal_hws[i]);
+		if (ret)
+			return;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(meson6_hw_clks); i++) {
+		/* the array is sparse */
+		if (!meson6_hw_clks[i])
+			continue;
+
+		ret = of_clk_hw_register(np, meson6_hw_clks[i]);
+		if (ret)
+			return;
+	}
+
+	ret = clk_notifier_register(meson6_cpu_scale_out_sel.hw.clk,
+				    &meson6_cpu_clk_nb);
+	if (ret) {
+		pr_err("%s: failed to register the CPU clock notifier\n",
+		       __func__);
+		return;
+	}
+
+	ret = of_clk_add_hw_provider(np, meson_clk_hw_get, &meson6_clk_hw_data);
+	if (ret)
+		pr_err("%s: failed to register the clock provider\n", __func__);
+}
+
+CLK_OF_DECLARE_DRIVER(meson6_clkc, "amlogic,meson6-clkc", meson6_clkc_init);
