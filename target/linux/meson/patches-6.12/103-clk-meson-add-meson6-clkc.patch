+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Amlogic Meson6 (AML8726-MX) clock controller
+ *
+ * The register layout of the peripheral clock (clk81), the CPU clock mux and
+ * the gates is the same as on Meson8b. The PLLs live at different offsets.
+ * The fixed PLL is described as it is left by the boot loader (read-only).
+ * The system PLL feeds only the CPU and is reprogrammed like in the vendor
+ * kernel; the CPU clock is switched between the outputs of its post dividers
+ * (/1, /2, /3) and the peripheral gates are controlled.
+ *
+ * The clock IDs of the Meson8b binding are reused.
+ */
+
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+
+#include "clk-regmap.h"
+#include "clk-pll.h"
+#include "meson-clkc-utils.h"
+
+#include <dt-bindings/clock/meson8b-clkc.h>
+
+#define HHI_GCLK_MPEG0			0x140
+#define HHI_GCLK_MPEG1			0x144
+#define HHI_GCLK_MPEG2			0x148
+#define HHI_MPEG_CLK_CNTL		0x174
+#define HHI_SYS_CPU_CLK_CNTL		0x19c
+#define HHI_SYS_PLL_CNTL		0x260
+#define HHI_SYS_PLL_CNTL2		0x264
+#define HHI_SYS_PLL_CNTL3		0x268
+#define HHI_SYS_PLL_CNTL4		0x26c
+#define HHI_MPLL_CNTL			0x280
+#define HHI_GEN_CLK_CNTL2		0x22c
+
+/* not part of the Meson8b binding: clock output 3 (32kHz for Wi-Fi modules) */
+#define MESON6_CLKID_CLK_OUT3		250
+
+static const struct clk_parent_data meson6_xtal = {
+	.fw_name = "xtal",
+	.name = "xtal",
+	.index = -1,
+};
+
+static struct clk_regmap meson6_fixed_pll_dco = {
+	.data = &(struct meson_clk_pll_data){
+		.en = {
+			.reg_off = HHI_MPLL_CNTL,
+			.shift   = 30,
+			.width   = 1,
+		},
+		.m = {
+			.reg_off = HHI_MPLL_CNTL,
+			.shift   = 0,
+			.width   = 9,
+		},
+		.n = {
+			.reg_off = HHI_MPLL_CNTL,
+			.shift   = 9,
+			.width   = 5,
+		},
+		.l = {
+			.reg_off = HHI_MPLL_CNTL,
+			.shift   = 31,
+			.width   = 1,
+		},
+		.rst = {
+			.reg_off = HHI_MPLL_CNTL,
+			.shift   = 29,
+			.width   = 1,
+		},
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "fixed_pll_dco",
+		.ops = &meson_clk_pll_ro_ops,
+		.parent_data = &meson6_xtal,
+		.num_parents = 1,
+	},
+};
+
+/*
+ * xtal * M / N gives 1000MHz with the values programmed by the boot loader
+ * while the vendor kernel reports 2000MHz and clk81 (fclk_div5 / 2) is known
+ * to be 200MHz. So the PLL output is twice the value of the M/N formula.
+ */
+static struct clk_fixed_factor meson6_fixed_pll = {
+	.mult = 2,
+	.div = 1,
+	.hw.init = &(struct clk_init_data){
+		.name = "fixed_pll",
+		.ops = &clk_fixed_factor_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_fixed_pll_dco.hw
+		},
+		.num_parents = 1,
+	},
+};
+
+#define MESON6_FCLK_DIV(_name, _div)					\
+static struct clk_fixed_factor meson6_##_name = {			\
+	.mult = 1,							\
+	.div = (_div),							\
+	.hw.init = &(struct clk_init_data){				\
+		.name = #_name,						\
+		.ops = &clk_fixed_factor_ops,				\
+		.parent_hws = (const struct clk_hw *[]) {		\
+			&meson6_fixed_pll.hw				\
+		},							\
+		.num_parents = 1,					\
+	},								\
+}
+
+MESON6_FCLK_DIV(fclk_div2, 2);
+MESON6_FCLK_DIV(fclk_div3, 3);
+MESON6_FCLK_DIV(fclk_div4, 4);
+MESON6_FCLK_DIV(fclk_div5, 5);
+MESON6_FCLK_DIV(fclk_div7, 7);
+
+static u32 meson6_mux_table_clk81[] = { 6, 5, 7 };
+
+static struct clk_regmap meson6_mpeg_clk_sel = {
+	.data = &(struct clk_regmap_mux_data){
+		.offset = HHI_MPEG_CLK_CNTL,
+		.mask = 0x7,
+		.shift = 12,
+		.table = meson6_mux_table_clk81,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "mpeg_clk_sel",
+		.ops = &clk_regmap_mux_ro_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_fclk_div3.hw,
+			&meson6_fclk_div4.hw,
+			&meson6_fclk_div5.hw,
+		},
+		.num_parents = 3,
+	},
+};
+
+static struct clk_regmap meson6_mpeg_clk_div = {
+	.data = &(struct clk_regmap_div_data){
+		.offset = HHI_MPEG_CLK_CNTL,
+		.shift = 0,
+		.width = 7,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "mpeg_clk_div",
+		.ops = &clk_regmap_divider_ro_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_mpeg_clk_sel.hw
+		},
+		.num_parents = 1,
+	},
+};
+
+static struct clk_regmap meson6_clk81 = {
+	.data = &(struct clk_regmap_gate_data){
+		.offset = HHI_MPEG_CLK_CNTL,
+		.bit_idx = 7,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "clk81",
+		.ops = &clk_regmap_gate_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_mpeg_clk_div.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_IS_CRITICAL,
+	},
+};
+
+/*
+ * The vendor kernel (arch/arm/mach-meson6/clock.c, sys_pll_settings) runs the
+ * system PLL with N = 1 and M = 32..63, i.e. 768..1512 MHz in 24 MHz steps,
+ * with the output divider at 1. Lower CPU rates come from the post dividers.
+ * While the PLL relocks the CPU is parked on the crystal by the notifier
+ * on cpu_scale_out_sel below.
+ */
+#define MESON6_SYS_PLL_M_MIN		32
+#define MESON6_SYS_PLL_M_MAX		63
+
+/* analog settings, vendor: M6_PLL_CNTL_CST2..4 */
+static const struct reg_sequence meson6_sys_pll_init_regs[] = {
+	{ .reg = HHI_SYS_PLL_CNTL2,	.def = 0x814d3928 },
+	{ .reg = HHI_SYS_PLL_CNTL3,	.def = 0x6b425012 },
+	{ .reg = HHI_SYS_PLL_CNTL4,	.def = 0x00000110 },
+};
+
+static unsigned long meson6_sys_pll_recalc_rate(struct clk_hw *hw,
+						unsigned long parent_rate)
+{
+	return meson_clk_pll_ro_ops.recalc_rate(hw, parent_rate);
+}
+
+static int meson6_sys_pll_determine_rate(struct clk_hw *hw,
+					 struct clk_rate_request *req)
+{
+	unsigned long m;
+
+	if (!req->best_parent_rate)
+		return -EINVAL;
+
+	m = clamp_t(unsigned long, req->rate / req->best_parent_rate,
+		    MESON6_SYS_PLL_M_MIN, MESON6_SYS_PLL_M_MAX);
+	req->rate = req->best_parent_rate * m;
+
+	return 0;
+}
+
+static int meson6_sys_pll_set_rate(struct clk_hw *hw, unsigned long rate,
+				   unsigned long parent_rate)
+{
+	struct clk_regmap *clk = to_clk_regmap(hw);
+	struct meson_clk_pll_data *pll = clk->data;
+	unsigned long m;
+	int delay = 5000;
+
+	if (!parent_rate)
+		return -EINVAL;
+
+	m = rate / parent_rate;
+	if (m < MESON6_SYS_PLL_M_MIN || m > MESON6_SYS_PLL_M_MAX ||
+	    m * parent_rate != rate)
+		return -EINVAL;
+
+	/* vendor: set_sys_pll() */
+	meson_parm_write(clk->map, &pll->rst, 1);
+	meson_parm_write(clk->map, &pll->n, 1);
+	meson_parm_write(clk->map, &pll->m, m);
+	regmap_multi_reg_write(clk->map, meson6_sys_pll_init_regs,
+			       ARRAY_SIZE(meson6_sys_pll_init_regs));
+	meson_parm_write(clk->map, &pll->rst, 0);
+
+	/* the lock bit is only valid after 100us */
+	udelay(100);
+	do {
+		if (meson_parm_read(clk->map, &pll->l))
+			return 0;
+		udelay(20);
+	} while (--delay);
+
+	pr_err("%s: the system PLL did not lock at %lu Hz\n", __func__, rate);
+
+	return -ETIMEDOUT;
+}
+
+static const struct clk_ops meson6_sys_pll_ops = {
+	.recalc_rate	= meson6_sys_pll_recalc_rate,
+	.determine_rate	= meson6_sys_pll_determine_rate,
+	.set_rate	= meson6_sys_pll_set_rate,
+};
+
+static struct clk_regmap meson6_sys_pll_dco = {
+	.data = &(struct meson_clk_pll_data){
+		.en = {
+			.reg_off = HHI_SYS_PLL_CNTL,
+			.shift   = 30,
+			.width   = 1,
+		},
+		.m = {
+			.reg_off = HHI_SYS_PLL_CNTL,
+			.shift   = 0,
+			.width   = 9,
+		},
+		.n = {
+			.reg_off = HHI_SYS_PLL_CNTL,
+			.shift   = 9,
+			.width   = 5,
+		},
+		.l = {
+			.reg_off = HHI_SYS_PLL_CNTL,
+			.shift   = 31,
+			.width   = 1,
+		},
+		.rst = {
+			.reg_off = HHI_SYS_PLL_CNTL,
+			.shift   = 29,
+			.width   = 1,
+		},
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "sys_pll_dco",
+		.ops = &meson6_sys_pll_ops,
+		.parent_data = &meson6_xtal,
+		.num_parents = 1,
+	},
+};
+
+static struct clk_regmap meson6_sys_pll = {
+	.data = &(struct clk_regmap_div_data){
+		.offset = HHI_SYS_PLL_CNTL,
+		.shift = 16,
+		.width = 2,
+		/* stays at 1 as set by the boot loader */
+		.flags = CLK_DIVIDER_POWER_OF_TWO | CLK_DIVIDER_READ_ONLY,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "sys_pll",
+		.ops = &clk_regmap_divider_ro_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_sys_pll_dco.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+/* bits 1:0 = 2 would select the DDR PLL which is not described here */
+static u32 meson6_mux_table_cpu_in[] = { 0, 1 };
+
+static struct clk_regmap meson6_cpu_in_sel = {
+	.data = &(struct clk_regmap_mux_data){
+		.offset = HHI_SYS_CPU_CLK_CNTL,
+		.mask = 0x3,
+		.shift = 0,
+		.table = meson6_mux_table_cpu_in,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "cpu_in_sel",
+		.ops = &clk_regmap_mux_ro_ops,
+		.parent_data = (const struct clk_parent_data[]) {
+			{ .fw_name = "xtal", .name = "xtal", .index = -1, },
+			{ .hw = &meson6_sys_pll.hw, },
+		},
+		.num_parents = 2,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+static struct clk_fixed_factor meson6_cpu_in_div2 = {
+	.mult = 1,
+	.div = 2,
+	.hw.init = &(struct clk_init_data){
+		.name = "cpu_in_div2",
+		.ops = &clk_fixed_factor_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_cpu_in_sel.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+static struct clk_fixed_factor meson6_cpu_in_div3 = {
+	.mult = 1,
+	.div = 3,
+	.hw.init = &(struct clk_init_data){
+		.name = "cpu_in_div3",
+		.ops = &clk_fixed_factor_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_cpu_in_sel.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+/* bits 3:2 = 3 would select a "/ (2 * N)" divider which is not described */
+static u32 meson6_mux_table_cpu_scale_out[] = { 0, 1, 2 };
+
+static struct clk_regmap meson6_cpu_scale_out_sel = {
+	.data = &(struct clk_regmap_mux_data){
+		.offset = HHI_SYS_CPU_CLK_CNTL,
+		.mask = 0x3,
+		.shift = 2,
+		.table = meson6_mux_table_cpu_scale_out,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "cpu_scale_out_sel",
+		/*
+		 * The rate is set by choosing a post divider and, through
+		 * CLK_SET_RATE_PARENT, the system PLL rate behind it.
+		 */
+		.ops = &clk_regmap_mux_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_cpu_in_sel.hw,
+			&meson6_cpu_in_div2.hw,
+			&meson6_cpu_in_div3.hw,
+		},
+		.num_parents = 3,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+static struct clk_regmap meson6_cpu_clk = {
+	.data = &(struct clk_regmap_mux_data){
+		.offset = HHI_SYS_CPU_CLK_CNTL,
+		.mask = 0x1,
+		.shift = 7,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "cpu_clk",
+		.ops = &clk_regmap_mux_ops,
+		.parent_data = (const struct clk_parent_data[]) {
+			{ .fw_name = "xtal", .name = "xtal", .index = -1, },
+			{ .hw = &meson6_cpu_scale_out_sel.hw, },
+		},
+		.num_parents = 2,
+		.flags = (CLK_SET_RATE_PARENT |
+			  CLK_SET_RATE_NO_REPARENT |
+			  CLK_IS_CRITICAL),
+	},
+};
+
+/* clock of the private timers and the SCU, vendor: a9_clk / 4 */
+static struct clk_fixed_factor meson6_periph_clk = {
+	.mult = 1,
+	.div = 4,
+	.hw.init = &(struct clk_init_data){
+		.name = "periph_clk",
+		.ops = &clk_fixed_factor_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_cpu_clk.hw
+		},
+		.num_parents = 1,
+	},
+};
+
+/*
+ * Like on Meson8b the CPU is parked on the crystal while the post divider
+ * mux or the system PLL behind it is changed, the vendor kernel does the same.
+ */
+static int meson6_cpu_clk_notifier_cb(struct notifier_block *nb,
+				      unsigned long event, void *data)
+{
+	struct clk_hw *parent_clk;
+	int ret;
+
+	switch (event) {
+	case PRE_RATE_CHANGE:
+		/* xtal */
+		parent_clk = clk_hw_get_parent_by_index(&meson6_cpu_clk.hw, 0);
+		break;
+
+	case POST_RATE_CHANGE:
+		/* cpu_scale_out_sel */
+		parent_clk = clk_hw_get_parent_by_index(&meson6_cpu_clk.hw, 1);
+		break;
+
+	default:
+		return NOTIFY_DONE;
+	}
+
+	ret = clk_hw_set_parent(&meson6_cpu_clk.hw, parent_clk);
+	if (ret)
+		return notifier_from_errno(ret);
+
+	udelay(100);
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block meson6_cpu_clk_nb = {
+	.notifier_call = meson6_cpu_clk_notifier_cb,
+};
+
+/* The gate bits are the same as on Meson8b (vendor: GCLK_IDX_*) */
+#define MESON6_GATE(_name, _reg, _bit) \
+	MESON_PCLK(_name, _reg, _bit, &meson6_clk81.hw)
+
+static MESON6_GATE(meson6_i2c, HHI_GCLK_MPEG0, 9);
+static MESON6_GATE(meson6_sar_adc, HHI_GCLK_MPEG0, 10);
+static MESON6_GATE(meson6_rng0, HHI_GCLK_MPEG0, 12);
+static MESON6_GATE(meson6_uart0, HHI_GCLK_MPEG0, 13);
+static MESON6_GATE(meson6_sdio, HHI_GCLK_MPEG0, 17);
+static MESON6_GATE(meson6_eth, HHI_GCLK_MPEG1, 3);
+static MESON6_GATE(meson6_uart1, HHI_GCLK_MPEG1, 16);
+static MESON6_GATE(meson6_usb0, HHI_GCLK_MPEG1, 21);
+static MESON6_GATE(meson6_usb1, HHI_GCLK_MPEG1, 22);
+static MESON6_GATE(meson6_usb, HHI_GCLK_MPEG1, 26);
+static MESON6_GATE(meson6_efuse, HHI_GCLK_MPEG1, 30);
+static MESON6_GATE(meson6_usb1_ddr_bridge, HHI_GCLK_MPEG2, 8);
+static MESON6_GATE(meson6_usb0_ddr_bridge, HHI_GCLK_MPEG2, 9);
+static MESON6_GATE(meson6_uart2, HHI_GCLK_MPEG2, 15);
+
+/*
+ * CLK_OUT3 on GPIOX_12. The vendor kernel selects the source with bit 22,
+ * sets the divider (bits 18:13) to 0 and enables the output with bit 21 to
+ * get the 32kHz low power clock of the Wi-Fi module. The source is not
+ * described, so the rate is unknown to the clock framework.
+ */
+static struct clk_regmap meson6_clk_out3 = {
+	.data = &(struct clk_regmap_gate_data){
+		.offset = HHI_GEN_CLK_CNTL2,
+		.bit_idx = 21,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "clk_out3",
+		.ops = &clk_regmap_gate_ops,
+		.num_parents = 0,
+	},
+};
