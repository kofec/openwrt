From cce53891c2b51f9c376c514c722f10a3c4475e00 Mon Sep 17 00:00:00 2001
From: kofec <kofec@localhost>
Date: Fri, 13 Nov 2026 22:13:59 +0000
Subject: [PATCH] drm/meson: transwitch-hdmi: add the Meson6 CEC controller

Meson6 has the CEC controller known from the GXBB/GXL AO CEC, but its
registers are part of the HDMI TX register space (0xc000..0xc0ff) and
there is no CEC interrupt status register. Received messages are handled
in the threaded interrupt (SPI 55), the end of a transmission is polled
like in the vendor kernel (TX_MSG_STATUS every 2ms, 2s timeout). The
physical address is taken from the EDID and invalidated on unplug.

Tested on the WeTek Play with a Sony TV: Give Device Power Status,
Give OSD Name, Image View On, Active Source and Standby.
---
 drivers/gpu/drm/meson/Kconfig                 |   1 +
 drivers/gpu/drm/meson/meson_transwitch_hdmi.c | 303 +++++++++++++++++-
 2 files changed, 303 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/meson/Kconfig b/drivers/gpu/drm/meson/Kconfig
index 2cf7d3474..c106d8790 100644
--- a/drivers/gpu/drm/meson/Kconfig
+++ b/drivers/gpu/drm/meson/Kconfig
@@ -37,4 +37,5 @@ config DRM_MESON_TRANSWITCH_HDMI
 	select DRM_DISPLAY_HDMI_STATE_HELPER
 	select DRM_DISPLAY_HELPER
 	select REGMAP_MMIO
+	select CEC_CORE
 	select SND_SOC_HDMI_CODEC if SND_SOC
diff --git a/drivers/gpu/drm/meson/meson_transwitch_hdmi.c b/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
index aa274ec42..fc9083743 100644
--- a/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
+++ b/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
@@ -7,6 +7,9 @@
  */
 
 #include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/workqueue.h>
 #include <linux/device.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
@@ -27,6 +30,8 @@
 
 #include <sound/hdmi-codec.h>
 
+#include <media/cec.h>
+
 #include <uapi/linux/media-bus-format.h>
 
 #include "meson_transwitch_hdmi.h"
@@ -47,6 +52,13 @@ struct meson_txc_hdmi {
 	/* Meson6: the PHY is controlled by TX_HDMI_PHY_CONFIG0..6 */
 	bool				internal_phy;
 
+	/* Meson6: CEC controller in the HDMI TX register space */
+	void __iomem			*base;
+	struct cec_adapter		*cec_adap;
+	struct delayed_work		cec_tx_work;
+	unsigned long			cec_tx_deadline;
+	bool				cec_tx_pending;
+
 	struct drm_bridge		bridge;
 	struct drm_bridge		*next_bridge;
 };
@@ -56,6 +68,7 @@ struct meson_txc_hdmi {
 static const struct regmap_range meson_txc_hdmi_regmap_ranges[] = {
 	regmap_reg_range(0x0000, 0x07ff),
 	regmap_reg_range(0x8000, 0x800c),
+	regmap_reg_range(0xc000, 0xc0ff),
 };
 
 static const struct regmap_access_table meson_txc_hdmi_regmap_access = {
@@ -97,7 +110,7 @@ static const struct regmap_config meson_txc_hdmi_regmap_config = {
 	.reg_write = meson_txc_hdmi_reg_write,
 	.rd_table = &meson_txc_hdmi_regmap_access,
 	.wr_table = &meson_txc_hdmi_regmap_access,
-	.max_register = HDMI_OTHER_RX_PACKET_INTR_CLR,
+	.max_register = 0xc0ff,
 	.fast_io = true,
 };
 
@@ -792,6 +805,274 @@ meson_txc_hdmi_bridge_mode_valid(struct drm_bridge *bridge,
 	return bridge->funcs->hdmi_tmds_char_rate_valid(bridge, mode, rate);
 }
 
+
+/*
+ * Meson6 CEC: the same CEC controller as the AO CEC of GXBB/GXL (see
+ * drivers/media/cec/platform/meson/ao-cec.c), but its registers are part of
+ * the HDMI TX register space at 0xc000 and there is no CEC interrupt status
+ * register. The interrupt (SPI 55) is used for received messages, the end of
+ * a transmission is polled like in the vendor kernel.
+ */
+#define MESON6_CEC_BASE			0xc000
+#define CEC_TX_MSG_0_HEADER		0x00
+#define CEC_TX_MSG_LENGTH		0x10
+#define CEC_TX_MSG_CMD			0x11
+#define CEC_TX_CLEAR_BUF		0x13
+#define CEC_RX_MSG_CMD			0x14
+#define CEC_RX_CLEAR_BUF		0x15
+#define CEC_LOGICAL_ADDR0		0x16
+#define CEC_CLOCK_DIV_H			0x1b
+#define CEC_CLOCK_DIV_L			0x1c
+#define CEC_RX_MSG_0_HEADER		0x80
+#define CEC_RX_MSG_LENGTH		0x90
+#define CEC_RX_MSG_STATUS		0x91
+#define CEC_RX_NUM_MSG			0x92
+#define CEC_TX_MSG_STATUS		0x93
+
+#define CEC_TX_NO_OP			0
+#define CEC_TX_REQ_CURRENT		1
+#define CEC_TX_ABORT			2
+
+#define CEC_TX_IDLE			0
+#define CEC_TX_BUSY			1
+#define CEC_TX_DONE			2
+#define CEC_TX_ERROR			3
+
+#define CEC_RX_NO_OP			0
+#define CEC_RX_ACK_CURRENT		1
+#define CEC_RX_DISABLE			2
+
+#define CEC_RX_DONE			2
+
+#define CEC_LOGICAL_ADDR_VALID		BIT(4)
+
+/* HDMI_OTHER_CTRL0 bit 3: cec_creg_sw_rst, bit 2: cec_sys_sw_rst */
+#define HDMI_OTHER_CTRL0_CEC_RESET	(BIT(3) | BIT(2))
+/* HDMI_CTRL_PORT bit 16: set by the vendor kernel around the CEC reset */
+#define HDMI_CTRL_PORT_CEC_RESET	BIT(16)
+
+#define CEC_TX_POLL_MS			2
+#define CEC_TX_TIMEOUT_MS		2000
+
+static unsigned int meson_txc_cec_read(struct meson_txc_hdmi *priv,
+				       unsigned int reg)
+{
+	unsigned int val = 0;
+
+	regmap_read(priv->regmap, MESON6_CEC_BASE + reg, &val);
+
+	return val & 0xff;
+}
+
+static void meson_txc_cec_write(struct meson_txc_hdmi *priv, unsigned int reg,
+				unsigned int val)
+{
+	regmap_write(priv->regmap, MESON6_CEC_BASE + reg, val);
+}
+
+static void meson_txc_cec_clear(struct meson_txc_hdmi *priv)
+{
+	meson_txc_cec_write(priv, CEC_RX_MSG_CMD, CEC_RX_DISABLE);
+	meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_ABORT);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 1);
+	meson_txc_cec_write(priv, CEC_TX_CLEAR_BUF, 1);
+	udelay(100);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 0);
+	meson_txc_cec_write(priv, CEC_TX_CLEAR_BUF, 0);
+	udelay(100);
+	meson_txc_cec_write(priv, CEC_RX_MSG_CMD, CEC_RX_NO_OP);
+	meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_NO_OP);
+}
+
+static int meson_txc_cec_adap_enable(struct cec_adapter *adap, bool enable)
+{
+	struct meson_txc_hdmi *priv = cec_get_drvdata(adap);
+
+	cancel_delayed_work_sync(&priv->cec_tx_work);
+	priv->cec_tx_pending = false;
+
+	if (!enable) {
+		regmap_write(priv->regmap, HDMI_OTHER_CTRL0,
+			     HDMI_OTHER_CTRL0_CEC_RESET);
+		return 0;
+	}
+
+	/* vendor: cec_hw_reset() */
+	writel(readl(priv->base + HDMI_CTRL_PORT) | HDMI_CTRL_PORT_CEC_RESET,
+	       priv->base + HDMI_CTRL_PORT);
+	regmap_write(priv->regmap, HDMI_OTHER_CTRL0, HDMI_OTHER_CTRL0_CEC_RESET);
+	meson_txc_cec_write(priv, CEC_TX_CLEAR_BUF, 1);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 1);
+	udelay(100);
+	meson_txc_cec_write(priv, CEC_TX_CLEAR_BUF, 0);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 0);
+	regmap_write(priv->regmap, HDMI_OTHER_CTRL0, 0);
+	writel(readl(priv->base + HDMI_CTRL_PORT) & ~HDMI_CTRL_PORT_CEC_RESET,
+	       priv->base + HDMI_CTRL_PORT);
+
+	meson_txc_cec_write(priv, CEC_CLOCK_DIV_H, 0x00);
+	meson_txc_cec_write(priv, CEC_CLOCK_DIV_L, 0xf0);
+	meson_txc_cec_write(priv, CEC_LOGICAL_ADDR0, 0);
+
+	meson_txc_cec_clear(priv);
+
+	return 0;
+}
+
+static int meson_txc_cec_log_addr(struct cec_adapter *adap, u8 logical_addr)
+{
+	struct meson_txc_hdmi *priv = cec_get_drvdata(adap);
+
+	meson_txc_cec_write(priv, CEC_LOGICAL_ADDR0, 0);
+	meson_txc_cec_clear(priv);
+
+	if (logical_addr == CEC_LOG_ADDR_INVALID)
+		return 0;
+
+	meson_txc_cec_write(priv, CEC_LOGICAL_ADDR0, logical_addr & 0xf);
+	udelay(100);
+	meson_txc_cec_write(priv, CEC_LOGICAL_ADDR0,
+			    (logical_addr & 0xf) | CEC_LOGICAL_ADDR_VALID);
+
+	return 0;
+}
+
+static int meson_txc_cec_transmit(struct cec_adapter *adap, u8 attempts,
+				  u32 signal_free_time, struct cec_msg *msg)
+{
+	struct meson_txc_hdmi *priv = cec_get_drvdata(adap);
+	unsigned int i;
+
+	if (meson_txc_cec_read(priv, CEC_TX_MSG_STATUS) == CEC_TX_BUSY)
+		meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_ABORT);
+
+	for (i = 0; i < msg->len; i++)
+		meson_txc_cec_write(priv, CEC_TX_MSG_0_HEADER + i, msg->msg[i]);
+
+	meson_txc_cec_write(priv, CEC_TX_MSG_LENGTH, msg->len - 1);
+	meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_REQ_CURRENT);
+
+	priv->cec_tx_pending = true;
+	priv->cec_tx_deadline = jiffies + msecs_to_jiffies(CEC_TX_TIMEOUT_MS);
+	mod_delayed_work(system_wq, &priv->cec_tx_work,
+			 msecs_to_jiffies(CEC_TX_POLL_MS));
+
+	return 0;
+}
+
+static void meson_txc_cec_tx_work(struct work_struct *work)
+{
+	struct meson_txc_hdmi *priv =
+		container_of(to_delayed_work(work), struct meson_txc_hdmi,
+			     cec_tx_work);
+	unsigned int stat;
+	u8 tx_status;
+
+	if (!priv->cec_tx_pending)
+		return;
+
+	stat = meson_txc_cec_read(priv, CEC_TX_MSG_STATUS);
+	switch (stat) {
+	case CEC_TX_DONE:
+		tx_status = CEC_TX_STATUS_OK;
+		break;
+	case CEC_TX_ERROR:
+		tx_status = CEC_TX_STATUS_NACK;
+		break;
+	default:
+		/* still idle (not started) or busy */
+		if (time_before(jiffies, priv->cec_tx_deadline)) {
+			schedule_delayed_work(&priv->cec_tx_work,
+					      msecs_to_jiffies(CEC_TX_POLL_MS));
+			return;
+		}
+		meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_ABORT);
+		tx_status = stat == CEC_TX_BUSY ? CEC_TX_STATUS_ARB_LOST :
+						   CEC_TX_STATUS_LOW_DRIVE;
+		break;
+	}
+
+	meson_txc_cec_write(priv, CEC_TX_MSG_CMD, CEC_TX_NO_OP);
+	priv->cec_tx_pending = false;
+	cec_transmit_attempt_done(priv->cec_adap, tx_status);
+}
+
+static irqreturn_t meson_txc_cec_irq_thread(int irq, void *data)
+{
+	struct meson_txc_hdmi *priv = data;
+	struct cec_msg msg = {};
+	unsigned int i;
+
+	if (priv->cec_tx_pending)
+		mod_delayed_work(system_wq, &priv->cec_tx_work, 0);
+
+	if (meson_txc_cec_read(priv, CEC_RX_MSG_STATUS) != CEC_RX_DONE)
+		goto out;
+
+	if (meson_txc_cec_read(priv, CEC_RX_NUM_MSG) != 1)
+		goto out;
+
+	msg.len = meson_txc_cec_read(priv, CEC_RX_MSG_LENGTH) + 1;
+	if (msg.len > CEC_MAX_MSG_SIZE)
+		msg.len = CEC_MAX_MSG_SIZE;
+
+	for (i = 0; i < msg.len; i++)
+		msg.msg[i] = meson_txc_cec_read(priv, CEC_RX_MSG_0_HEADER + i);
+
+	cec_received_msg(priv->cec_adap, &msg);
+
+out:
+	meson_txc_cec_write(priv, CEC_RX_MSG_CMD, CEC_RX_ACK_CURRENT);
+	meson_txc_cec_write(priv, CEC_RX_MSG_CMD, CEC_RX_NO_OP);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 1);
+	meson_txc_cec_write(priv, CEC_RX_CLEAR_BUF, 0);
+
+	return IRQ_HANDLED;
+}
+
+static const struct cec_adap_ops meson_txc_cec_ops = {
+	.adap_enable = meson_txc_cec_adap_enable,
+	.adap_log_addr = meson_txc_cec_log_addr,
+	.adap_transmit = meson_txc_cec_transmit,
+};
+
+static int meson_txc_cec_init(struct meson_txc_hdmi *priv, struct device *dev)
+{
+	int irq, ret;
+
+	irq = platform_get_irq_byname_optional(to_platform_device(dev), "cec");
+	if (irq < 0)
+		return 0;
+
+	INIT_DELAYED_WORK(&priv->cec_tx_work, meson_txc_cec_tx_work);
+
+	priv->cec_adap = cec_allocate_adapter(&meson_txc_cec_ops, priv,
+					      "meson6-hdmi-cec",
+					      CEC_CAP_DEFAULTS, 1);
+	if (IS_ERR(priv->cec_adap))
+		return PTR_ERR(priv->cec_adap);
+
+	ret = devm_request_threaded_irq(dev, irq, NULL,
+					meson_txc_cec_irq_thread, IRQF_ONESHOT,
+					"meson6-hdmi-cec", priv);
+	if (ret)
+		goto err_delete;
+
+	/* keep the controller in reset until the adapter is enabled */
+	regmap_write(priv->regmap, HDMI_OTHER_CTRL0, HDMI_OTHER_CTRL0_CEC_RESET);
+
+	ret = cec_register_adapter(priv->cec_adap, dev);
+	if (ret)
+		goto err_delete;
+
+	return 0;
+
+err_delete:
+	cec_delete_adapter(priv->cec_adap);
+	priv->cec_adap = NULL;
+	return ret;
+}
+
 static enum drm_connector_status meson_txc_hdmi_bridge_detect(struct drm_bridge *bridge)
 {
 	struct meson_txc_hdmi *priv = bridge_to_meson_txc_hdmi(bridge);
@@ -800,6 +1081,9 @@ static enum drm_connector_status meson_txc_hdmi_bridge_detect(struct drm_bridge
 			     TX_HDCP_ST_EDID_STATUS_HPD_STATUS) > 0)
 		return connector_status_connected;
 
+	if (priv->cec_adap)
+		cec_phys_addr_invalidate(priv->cec_adap);
+
 	return connector_status_disconnected;
 }
 
@@ -850,6 +1134,10 @@ static const struct drm_edid *meson_txc_hdmi_bridge_edid_read(struct drm_bridge
 		return NULL;
 	}
 
+	if (priv->cec_adap)
+		cec_s_phys_addr_from_edid(priv->cec_adap,
+					  drm_edid_raw(drm_edid));
+
 	return drm_edid;
 }
 
@@ -1373,6 +1661,8 @@ static int meson_txc_hdmi_probe(struct platform_device *pdev)
 	regval |= HDMI_CTRL_PORT_APB3_ERR_EN;
 	writel(regval, base + HDMI_CTRL_PORT);
 
+	priv->base = base;
+
 	ret = meson_txc_hdmi_hw_init(priv, dev);
 	if (ret)
 		return ret;
@@ -1399,6 +1689,12 @@ static int meson_txc_hdmi_probe(struct platform_device *pdev)
 
 	drm_bridge_add(&priv->bridge);
 
+	if (priv->internal_phy) {
+		ret = meson_txc_cec_init(priv, dev);
+		if (ret)
+			dev_warn(dev, "CEC not available: %d\n", ret);
+	}
+
 	return 0;
 }
 
@@ -1406,6 +1702,11 @@ static void meson_txc_hdmi_remove(struct platform_device *pdev)
 {
 	struct meson_txc_hdmi *priv = platform_get_drvdata(pdev);
 
+	if (priv->cec_adap) {
+		cec_unregister_adapter(priv->cec_adap);
+		cancel_delayed_work_sync(&priv->cec_tx_work);
+	}
+
 	drm_bridge_remove(&priv->bridge);
 
 	meson_txc_hdmi_hw_exit(priv, &pdev->dev);
