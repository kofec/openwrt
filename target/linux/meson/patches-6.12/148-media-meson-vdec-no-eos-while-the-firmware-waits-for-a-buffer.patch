From: kofec
Subject: [PATCH] media: meson: vdec: no EOS from the drain watchdog while the firmware waits for a buffer

The drain watchdog (patch 138) returns an empty LAST buffer after 300 ms
without a decoder interrupt once the EOS sequence is queued. With H.264
1080p, FFmpeg holds about 15 capture buffers; the firmware then stops and
waits for a free picture buffer (AV_SCRATCH_9 bit 31, the vendor
wait_buffer_status) and the watchdog took that silence for the end of the
stream: 15 of 75 pictures.

Add an optional codec op starved() and keep waiting, without the second
EOS sequence and without LAST, while it reports the firmware waiting for
a buffer. H.264 implements it with AV_SCRATCH_9 bit 31. An application that holds
every buffer and waits for LAST still gets it 3 s after its last
capture QBUF.

--- a/drivers/staging/media/meson/vdec/codec_h264.c	2026-11-19 23:13:45.000000000 +0100
+++ b/drivers/staging/media/meson/vdec/codec_h264.c	2026-11-19 23:33:26.953847800 +0100
@@ -597,6 +597,15 @@
 	return IRQ_WAKE_THREAD;
 }
 
+/*
+ * AV_SCRATCH_9 bit 31: the firmware waits for a free picture buffer
+ * (vendor vh264_put_timer_func(), wait_buffer_status).
+ */
+static bool codec_h264_starved(struct amvdec_session *sess)
+{
+	return amvdec_read_dos(sess->core, AV_SCRATCH_9) & BIT(31);
+}
+
 struct amvdec_codec_ops codec_h264_ops = {
 	.start = codec_h264_start,
 	.stop = codec_h264_stop,
@@ -606,5 +615,6 @@
 	.can_recycle = codec_h264_can_recycle,
 	.recycle = codec_h264_recycle,
 	.eos_sequence = codec_h264_eos_sequence,
+	.starved = codec_h264_starved,
 	.resume = codec_h264_resume,
 };
--- a/drivers/staging/media/meson/vdec/vdec.c	2026-11-19 19:03:25.000000000 +0100
+++ b/drivers/staging/media/meson/vdec/vdec.c	2026-11-19 23:44:06.391033600 +0100
@@ -146,6 +146,20 @@
 		goto again;
 
 	/*
+	 * Silence because the firmware waits for a capture buffer userspace
+	 * still holds (H.264 1080p: the application keeps a dozen pictures)
+	 * is not the end of the stream: neither resend the EOS nor return
+	 * LAST, which cut the stream at the first starvation. Only while
+	 * userspace still returns buffers: one that holds them all and waits
+	 * for LAST gets it after VDEC_DRAIN_STARVED_MS.
+	 */
+	if (sess->fmt_out->codec_ops->starved &&
+	    sess->fmt_out->codec_ops->starved(sess) &&
+	    time_is_after_jiffies64(max(sess->cap_qbuf_jiffies, last) +
+				    msecs_to_jiffies(VDEC_DRAIN_STARVED_MS)))
+		goto again;
+
+	/*
 	 * The Meson6 MPEG-2 firmware sometimes reads the end of sequence code
 	 * and still keeps its last reference picture; a second EOS sequence
 	 * gets it out. Try that once before giving up on the last picture.
@@ -362,6 +376,8 @@
 	struct v4l2_m2m_ctx *m2m_ctx = sess->m2m_ctx;
 
 	v4l2_m2m_buf_queue(m2m_ctx, vbuf);
+	if (vb->type == V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE)
+		sess->cap_qbuf_jiffies = get_jiffies_64();
 
 	if (!sess->streamon_out)
 		return;
--- a/drivers/staging/media/meson/vdec/vdec.h	2026-11-19 19:03:25.000000000 +0100
+++ b/drivers/staging/media/meson/vdec/vdec.h	2026-11-19 23:44:15.639097500 +0100
@@ -139,6 +139,8 @@
 	int (*can_recycle)(struct amvdec_core *core);
 	void (*recycle)(struct amvdec_core *core, u32 buf_idx);
 	bool (*watchdog)(struct amvdec_session *sess);
+	/* optional: the firmware waits for a capture buffer userspace holds */
+	bool (*starved)(struct amvdec_session *sess);
 	void (*drain)(struct amvdec_session *sess);
 	void (*resume)(struct amvdec_session *sess);
 	const u8 * (*eos_sequence)(u32 *len);
@@ -238,6 +240,7 @@
  * @priv: codec private data
  */
 #define VDEC_DRAIN_POLL_MS	100
+#define VDEC_DRAIN_STARVED_MS	3000
 #define VDEC_DRAIN_IDLE_MS	300
 
 struct amvdec_session {
@@ -297,6 +300,8 @@
 	u64 last_irq_jiffies;
 	/* set by stop_streaming: the threaded ISR must leave the buffers */
 	bool isr_stop;
+	/* last capture buffer queued by userspace, see vdec_drain_work() */
+	u64 cap_qbuf_jiffies;
 	u32 last_offset;
 	u32 wrap_count;
 	u32 fw_idx_to_vb2_idx[32];
