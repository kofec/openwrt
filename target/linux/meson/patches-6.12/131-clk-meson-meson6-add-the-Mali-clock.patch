From 4752c67dfa5186e54f3b30b91e90d732376696f7 Mon Sep 17 00:00:00 2001
From: kofec <kofec@localhost>
Date: Sat, 14 Nov 2026 13:04:01 +0000
Subject: [PATCH 131/134] clk: meson: meson6: add the Mali clock

HHI_MALI_CLK_CNTL as used by the vendor kernel (_clk_set_rate_gpu() in
mach-meson6/clock.c): source in bits 11..9 (fclk_div2, fclk_div3,
fclk_div5), divider in bits 6..0, gate in bit 8. Unlike Meson8/8b there
is only one clock and no glitch-free mux. The IDs of the Meson8b binding
are reused (CLKID_MALI_0_SEL, CLKID_MALI_0_DIV, CLKID_MALI_0, CLKID_MALI).
---
 drivers/clk/meson/meson6.c | 69 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/drivers/clk/meson/meson6.c b/drivers/clk/meson/meson6.c
index cd74fc8de..64ce474aa 100644
--- a/drivers/clk/meson/meson6.c
+++ b/drivers/clk/meson/meson6.c
@@ -56,6 +56,7 @@
 #define HHI_SYS_PLL_CNTL4		0x26c
 #define HHI_MPLL_CNTL			0x280
 #define HHI_GEN_CLK_CNTL2		0x22c
+#define HHI_MALI_CLK_CNTL		0x1b0
 
 /* not part of the Meson8b binding: clock output 3 (32kHz for Wi-Fi modules) */
 #define MESON6_CLKID_CLK_OUT3		250
@@ -1720,6 +1721,67 @@ static MESON6_GATE(meson6_i2s_out, HHI_GCLK_MPEG1, 8);
 static MESON6_GATE(meson6_mixer_iface, HHI_GCLK_MPEG1, 12);
 static MESON6_GATE(meson6_aoclk_gate, HHI_GCLK_OTHER, 1);
 
+/*
+ * Mali-400 MP2 clock (vendor: _clk_set_rate_gpu() in mach-meson6/clock.c):
+ * source in bits 11..9 (5 = fclk_div2, 6 = fclk_div3, 7 = fclk_div5), divider
+ * in bits 6..0, gate in bit 8. Unlike Meson8/8b there is only one clock and
+ * no glitch-free mux. The vendor kernel runs it at 333 MHz (fclk_div3 / 2),
+ * at most 400 MHz, and always keeps the CPU clock above the GPU clock.
+ */
+static u32 meson6_mali_mux_table[] = { 5, 6, 7 };
+
+static struct clk_regmap meson6_mali_0_sel = {
+	.data = &(struct clk_regmap_mux_data){
+		.offset = HHI_MALI_CLK_CNTL,
+		.mask = 0x7,
+		.shift = 9,
+		.table = meson6_mali_mux_table,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "mali_0_sel",
+		.ops = &clk_regmap_mux_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_fclk_div2.hw,
+			&meson6_fclk_div3.hw,
+			&meson6_fclk_div5.hw,
+		},
+		.num_parents = 3,
+	},
+};
+
+static struct clk_regmap meson6_mali_0_div = {
+	.data = &(struct clk_regmap_div_data){
+		.offset = HHI_MALI_CLK_CNTL,
+		.shift = 0,
+		.width = 7,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "mali_0_div",
+		.ops = &clk_regmap_divider_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_mali_0_sel.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
+static struct clk_regmap meson6_mali_0 = {
+	.data = &(struct clk_regmap_gate_data){
+		.offset = HHI_MALI_CLK_CNTL,
+		.bit_idx = 8,
+	},
+	.hw.init = &(struct clk_init_data){
+		.name = "mali_0",
+		.ops = &clk_regmap_gate_ops,
+		.parent_hws = (const struct clk_hw *[]) {
+			&meson6_mali_0_div.hw
+		},
+		.num_parents = 1,
+		.flags = CLK_SET_RATE_PARENT,
+	},
+};
+
 /* clocks which are not exposed through the DT binding, parents first */
 static struct clk_hw *meson6_internal_hws[] = {
 	&meson6_fixed_pll_dco.hw,
@@ -1776,6 +1838,10 @@ static struct clk_hw *meson6_hw_clks[] = {
 	[CLKID_I2S_OUT]			= &meson6_i2s_out.hw,
 	[CLKID_MIXER_IFACE]		= &meson6_mixer_iface.hw,
 	[CLKID_AOCLK_GATE]		= &meson6_aoclk_gate.hw,
+	[CLKID_MALI_0_SEL]		= &meson6_mali_0_sel.hw,
+	[CLKID_MALI_0_DIV]		= &meson6_mali_0_div.hw,
+	[CLKID_MALI_0]			= &meson6_mali_0.hw,
+	[CLKID_MALI]			= &meson6_mali_0.hw,
 	[CLKID_HDMI_PLL_DCO] = &meson6_hdmi_pll_dco.hw,
 	[CLKID_HDMI_PLL_LVDS_OUT] = &meson6_hdmi_pll_lvds_out.hw,
 	[CLKID_HDMI_PLL_HDMI_OUT] = &meson6_hdmi_pll_hdmi_out.hw,
@@ -1910,6 +1976,9 @@ static struct clk_regmap *const meson6_clk_regmaps[] = {
 	&meson6_i2s_out,
 	&meson6_mixer_iface,
 	&meson6_aoclk_gate,
+	&meson6_mali_0_sel,
+	&meson6_mali_0_div,
+	&meson6_mali_0,
 };
 
 static struct meson_clk_hw_data meson6_clk_hw_data = {
-- 
