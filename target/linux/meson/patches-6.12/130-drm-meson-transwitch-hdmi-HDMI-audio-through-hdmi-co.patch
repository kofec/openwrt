From 66eba0d09e5bcc072f8f0a585053c5fa3b426c35 Mon Sep 17 00:00:00 2001
From: kofec <kofec@localhost>
Date: Sat, 14 Nov 2026 07:42:46 +0000
Subject: [PATCH] drm/meson: transwitch-hdmi: HDMI audio through hdmi-codec on
 6.12

6.12 has no HDMI audio bridge helpers yet, register an hdmi-codec device
with Martin Blumenstingl's audio functions. hw_params instead of prepare:
codec-to-codec links only call hw_params on 6.12.
---
 drivers/gpu/drm/meson/Kconfig                 |   1 +
 drivers/gpu/drm/meson/meson_transwitch_hdmi.c | 104 +++++++++++++++++-
 2 files changed, 103 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/meson/Kconfig b/drivers/gpu/drm/meson/Kconfig
index c106d8790..a5a2c8765 100644
--- a/drivers/gpu/drm/meson/Kconfig
+++ b/drivers/gpu/drm/meson/Kconfig
@@ -38,4 +38,5 @@ config DRM_MESON_TRANSWITCH_HDMI
 	select DRM_DISPLAY_HELPER
 	select REGMAP_MMIO
 	select CEC_CORE
+	imply SND_SOC_HDMI_CODEC
 	select SND_SOC_HDMI_CODEC if SND_SOC
diff --git a/drivers/gpu/drm/meson/meson_transwitch_hdmi.c b/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
index fc9083743..911b08fb1 100644
--- a/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
+++ b/drivers/gpu/drm/meson/meson_transwitch_hdmi.c
@@ -52,6 +52,10 @@ struct meson_txc_hdmi {
 	/* Meson6: the PHY is controlled by TX_HDMI_PHY_CONFIG0..6 */
 	bool				internal_phy;
 
+	/* HDMI audio through an hdmi-codec device (6.12) */
+	struct platform_device		*audio_pdev;
+	struct drm_connector		*connector;
+
 	/* Meson6: CEC controller in the HDMI TX register space */
 	void __iomem			*base;
 	struct cec_adapter		*cec_adap;
@@ -663,6 +667,8 @@ static void meson_txc_hdmi_bridge_atomic_enable(struct drm_bridge *bridge,
 		colorimetry = HDMI_COLORIMETRY_NONE;
 	}
 
+	priv->connector = connector;
+
 	drm_atomic_helper_connector_hdmi_update_infoframes(connector, state);
 
 	meson_txc_hdmi_sys5_reset_assert(priv);
@@ -1238,7 +1244,6 @@ static int meson_txc_hdmi_write_infoframe(struct drm_bridge *bridge,
 	return 0;
 }
 
-#ifdef MESON_TXC_HDMI_AUDIO /* needs the HDMI audio bridge helpers from v6.14 */
 static u32 meson_txc_hdmi_hdmi_codec_calc_audio_n(struct hdmi_codec_params *hparms)
 {
 	u32 audio_n;
@@ -1452,7 +1457,79 @@ static void meson_txc_hdmi_audio_shutdown(struct drm_connector *connector,
 	regmap_set_bits(priv->regmap, TX_PACKET_CONTROL_2,
 			TX_PACKET_CONTROL_2_AUDIO_REQUEST_DISABLE);
 }
-#endif
+
+/*
+ * 6.12 has no HDMI audio helpers for bridges yet (hdmi_audio_* bridge
+ * callbacks, v6.14), so register an hdmi-codec device like other bridge
+ * drivers do. The DRM connector is remembered in atomic_enable.
+ */
+static int meson_txc_hdmi_codec_startup(struct device *dev, void *data)
+{
+	struct meson_txc_hdmi *priv = data;
+
+	return meson_txc_hdmi_audio_startup(priv->connector, &priv->bridge);
+}
+
+static int meson_txc_hdmi_codec_prepare(struct device *dev, void *data,
+					struct hdmi_codec_daifmt *fmt,
+					struct hdmi_codec_params *hparms)
+{
+	struct meson_txc_hdmi *priv = data;
+
+	if (!priv->connector)
+		return -ENODEV;
+
+	return meson_txc_hdmi_audio_prepare(priv->connector, &priv->bridge,
+					    fmt, hparms);
+}
+
+static int meson_txc_hdmi_codec_mute_stream(struct device *dev, void *data,
+					    bool enable, int direction)
+{
+	struct meson_txc_hdmi *priv = data;
+
+	return meson_txc_hdmi_audio_mute_stream(priv->connector, &priv->bridge,
+						enable, direction);
+}
+
+static void meson_txc_hdmi_codec_shutdown(struct device *dev, void *data)
+{
+	struct meson_txc_hdmi *priv = data;
+
+	if (priv->connector)
+		meson_txc_hdmi_audio_shutdown(priv->connector, &priv->bridge);
+}
+
+static int meson_txc_hdmi_codec_get_eld(struct device *dev, void *data,
+					uint8_t *buf, size_t len)
+{
+	struct meson_txc_hdmi *priv = data;
+	struct drm_connector *connector = priv->connector;
+
+	if (!connector) {
+		memset(buf, 0, len);
+		return 0;
+	}
+
+	mutex_lock(&connector->eld_mutex);
+	memcpy(buf, connector->eld, min(sizeof(connector->eld), len));
+	mutex_unlock(&connector->eld_mutex);
+
+	return 0;
+}
+
+static const struct hdmi_codec_ops meson_txc_hdmi_codec_ops = {
+	.audio_startup = meson_txc_hdmi_codec_startup,
+	/*
+	 * hw_params, not prepare: in 6.12 the codec-to-codec link from the AIU
+	 * HDMI control only calls hw_params (DAPM prepare support is v6.14).
+	 */
+	.hw_params = meson_txc_hdmi_codec_prepare,
+	.mute_stream = meson_txc_hdmi_codec_mute_stream,
+	.audio_shutdown = meson_txc_hdmi_codec_shutdown,
+	.get_eld = meson_txc_hdmi_codec_get_eld,
+	.no_capture_mute = 1,
+};
 
 static const struct drm_bridge_funcs meson_txc_hdmi_bridge_funcs = {
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
@@ -1689,6 +1766,26 @@ static int meson_txc_hdmi_probe(struct platform_device *pdev)
 
 	drm_bridge_add(&priv->bridge);
 
+	{
+		struct hdmi_codec_pdata pdata = {
+			.ops = &meson_txc_hdmi_codec_ops,
+			.i2s = 1,
+			.spdif = 1,
+			.max_i2s_channels = 8,
+			.data = priv,
+		};
+
+		priv->audio_pdev =
+			platform_device_register_data(dev, HDMI_CODEC_DRV_NAME,
+						      PLATFORM_DEVID_AUTO,
+						      &pdata, sizeof(pdata));
+		if (IS_ERR(priv->audio_pdev)) {
+			dev_warn(dev, "HDMI audio not available: %ld\n",
+				 PTR_ERR(priv->audio_pdev));
+			priv->audio_pdev = NULL;
+		}
+	}
+
 	if (priv->internal_phy) {
 		ret = meson_txc_cec_init(priv, dev);
 		if (ret)
@@ -1702,6 +1799,9 @@ static void meson_txc_hdmi_remove(struct platform_device *pdev)
 {
 	struct meson_txc_hdmi *priv = platform_get_drvdata(pdev);
 
+	if (priv->audio_pdev)
+		platform_device_unregister(priv->audio_pdev);
+
 	if (priv->cec_adap) {
 		cec_unregister_adapter(priv->cec_adap);
 		cancel_delayed_work_sync(&priv->cec_tx_work);
