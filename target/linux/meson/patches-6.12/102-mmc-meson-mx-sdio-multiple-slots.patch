+	/* switch the clock divider and the bus width to the ones of the slot */
+	conf = readl(host->base + MESON_MX_SDIO_CONF);
+	conf &= ~(MESON_MX_SDIO_CONF_CMD_CLK_DIV_MASK |
+		  MESON_MX_SDIO_CONF_BUS_WIDTH);
+	conf |= FIELD_PREP(MESON_MX_SDIO_CONF_CMD_CLK_DIV_MASK, slot->conf_div);
+	if (slot->bus_width_4)
+		conf |= MESON_MX_SDIO_CONF_BUS_WIDTH;
+	writel(conf, host->base + MESON_MX_SDIO_CONF);
+
+	if (mrq->data)
+		writel(sg_dma_address(mrq->data->sg),
+		       host->base + MESON_MX_SDIO_ADDR);
+
+	if (mrq->sbc)
+		meson_mx_mmc_start_cmd(host, mrq->sbc);
+	else
+		meson_mx_mmc_start_cmd(host, mrq->cmd);
