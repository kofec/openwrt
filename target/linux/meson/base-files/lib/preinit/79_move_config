#
# Konfigurację zachowaną przez sysupgrade platform_copy_config kładzie na
# partycji FAT karty. Hak preinit_mount_root działa po mount_root, więc
# / jest już zapisywalny; 80_mount_root zaraz potem rozpakuje /sysupgrade.tgz.

move_config() {
	local partdev

	. /lib/upgrade/common.sh

	export_bootdevice && export_partdevice partdev 1 || return 0

	# vfat jest modułem, a w preinit moduły z /etc/modules.d nie są jeszcze ładowane
	insmod nls_cp437 2>/dev/null
	insmod nls_iso8859-1 2>/dev/null
	insmod fat 2>/dev/null
	insmod vfat 2>/dev/null

	mkdir -p /tmp/meson_boot
	# zwykle pliku nie ma: tylko do odczytu, żeby nie ruszać FAT przy każdym starcie
	mount -t vfat -o ro "/dev/$partdev" /tmp/meson_boot || return 0
	if [ -f "/tmp/meson_boot/$BACKUP_FILE" ] &&
	   mount -o remount,rw,noatime /tmp/meson_boot; then
		mv -f "/tmp/meson_boot/$BACKUP_FILE" /
		sync
	fi
	umount /tmp/meson_boot
	rmdir /tmp/meson_boot
}

[ "$INITRAMFS" = "1" ] || boot_hook_add preinit_mount_root move_config
